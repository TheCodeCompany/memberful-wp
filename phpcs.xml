<?xml version="1.0"?>
<ruleset name="Memberful WP">
	<description>Memberful WP Coding Standards</description>

	<file>.</file>
	<exclude-pattern>.(git|github|vscode|idea|wordpress-org)</exclude-pattern>
	<exclude-pattern>*\.(inc|css|js|svg)</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*.asset.php</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>

	<arg value="ps"/>
	<arg name="basepath" value="."/><!-- Strip the file paths down to the relevant bit -->
	<arg name="colors"/>
	<arg name="parallel" value="50"/>

	<rule ref="PHPCompatibility"/>
	<config name="testVersion" value="8.1-"/>
	<rule ref="PHPCompatibilityWP"/>
	<config name="minimum_supported_wp_version" value="6.6"/>

	<config name="text_domain" value="memberful_wp,memberful,memberful-wp,default"/>

	<rule ref="WordPress"/>
	<rule ref="VariableAnalysis"/>
</ruleset>
